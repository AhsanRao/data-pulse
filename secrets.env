# API Keys for DataPulse
#
# Because the virtual environment lives in .env/, copy this file to
# secrets.env (preferred) or ~/.datapulse/.env instead:
#
#   cp .env.example secrets.env
#   # then edit secrets.env

ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed for bot-protected sites
SCRAPERAPI_KEY=
ZYTE_API_KEY=
