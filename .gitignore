# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST
.installed.cfg
wheels/
share/python-wheels/

# Tests / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ── Environments ──────────────────────────────────────────────────────────────
# .env/ is the Python 3.14 venv for this project (not a dotenv file)
.env
.venv
env/
venv/
ENV/

# ── Secrets & keys ───────────────────────────────────────────────────────────
secrets.env
*.env.local

# ── DataPulse runtime output ──────────────────────────────────────────────────
# Jobs and logs in project-local .datapulse/
.datapulse/
# All output files (JSON, CSV, debug HTML) go here
output/

# ── Playwright ───────────────────────────────────────────────────────────────
# Browser binaries downloaded by playwright install (lives in ~/.cache normally)
.playwright/
playwright/.cache/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
# Finder leftover — macOS sometimes creates a bare ~ directory
~
~$*

# ── IDE / editors ─────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*.swo
.spyderproject
.ropeproject

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

