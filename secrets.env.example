# ── DataPulse Secrets Template ────────────────────────────────────────────────
#
# Copy this file to secrets.env and fill in your values:
#   cp secrets.env.example secrets.env
#
# secrets.env is gitignored — never commit real keys.
#
# ── Primary LLM (OpenAI-compatible endpoint) ──────────────────────────────────
#
# Set all three to use any OpenAI-compatible provider.
# Exactly one of these setups should be active:
#
#   Option A — LiteLLM proxy (self-hosted, routes to any model):
#     LLM_BASE_URL=http://your-server:4000
#     LLM_API_KEY=your-litellm-key
#     LLM_MODEL=your-model-name
#
#   Option B — OpenAI directly:
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_API_KEY=sk-...
#     LLM_MODEL=gpt-4o-mini
#
#   Option C — Anthropic via OpenAI-compatible endpoint:
#     LLM_BASE_URL=https://api.anthropic.com/v1
#     LLM_API_KEY=sk-ant-...
#     LLM_MODEL=claude-haiku-4-5-20251001
#
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Anthropic direct SDK (optional fallback) ───────────────────────────────────
#
# Used only if LLM_BASE_URL is not set or unreachable.
# When active, model is controlled by llm.selector_model in datapulse.config.yaml.
#
ANTHROPIC_API_KEY=

# ── Anti-bot scraping proxies (optional) ──────────────────────────────────────
#
# Only used as last resort if both httpx and Playwright get Cloudflare-blocked.
# ScraperAPI free tier: 1000 requests/month — https://www.scraperapi.com
# Zyte: pay-per-use — https://www.zyte.com
#
SCRAPERAPI_KEY=
ZYTE_API_KEY=
