# ── DataPulse Secrets Template ────────────────────────────────────────────────
#
# Copy this file to secrets.env and fill in your values:
#   cp secrets.env.example secrets.env
#
# secrets.env is gitignored — never commit real keys.
#
# ── Primary LLM (OpenAI-compatible endpoint) ──────────────────────────────────
#
# Set all four vars for any OpenAI-compatible provider. Pick ONE option below:
#
#   Option A — Google Gemini:
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_API_KEY=AIza...
#     LLM_MODEL=gemini-2.0-flash
#     LLM_CHAT_PATH=/chat/completions
#
#   Option B — OpenAI directly:
#     LLM_BASE_URL=https://api.openai.com
#     LLM_API_KEY=sk-...
#     LLM_MODEL=gpt-4o-mini
#     LLM_CHAT_PATH=/v1/chat/completions
#
#   Option C — Anthropic via OpenAI-compatible endpoint:
#     LLM_BASE_URL=https://api.anthropic.com/v1
#     LLM_API_KEY=sk-ant-...
#     LLM_MODEL=claude-haiku-4-5-20251001
#     LLM_CHAT_PATH=/chat/completions
#
#   Option D — Self-hosted / local model server:
#     LLM_BASE_URL=http://your-server:4000
#     LLM_API_KEY=your-key
#     LLM_MODEL=your-model-name
#     LLM_CHAT_PATH=/v1/chat/completions
#
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CHAT_PATH=

# ── Anthropic direct SDK (optional fallback) ───────────────────────────────────
#
# Used only if LLM_BASE_URL is not set.
# Model defaults to claude-haiku-4-5-20251001 — override with ANTHROPIC_MODEL.
#
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Ollama local model (optional fallback) ────────────────────────────────────
#
# Used only if neither LLM_BASE_URL nor ANTHROPIC_API_KEY is set, and Ollama is running.
# Model defaults to qwen2.5:1.5b — override here or in datapulse.config.yaml (local_model).
# Pull a model first: ollama pull qwen2.5-coder:7b
#
OLLAMA_MODEL=

# ── Anti-bot scraping proxies (optional) ──────────────────────────────────────
#
# Only used as last resort if both httpx and Playwright get Cloudflare-blocked.
# ScraperAPI free tier: 1000 requests/month — https://www.scraperapi.com
# Zyte: pay-per-use — https://www.zyte.com
#
SCRAPERAPI_KEY=
ZYTE_API_KEY=
